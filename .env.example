# ---- PayPal ---------------------------------------------------------------
# mock    = local sandbox simulator (no account needed, default)
# sandbox = real PayPal sandbox (https://developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown in the dashboard after you add a webhook pointing to
# <PUBLIC_BASE_URL>/webhooks/paypal (events: PAYMENT.CAPTURE.*, CHECKOUT.ORDER.APPROVED)
PAYPAL_WEBHOOK_ID=
# Public URL of this app (used for PayPal return/cancel URLs and the webhook)
PUBLIC_BASE_URL=http://localhost:8000

# ---- LLM ------------------------------------------------------------------
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the offline demo brain
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low

# ---- Shop -----------------------------------------------------------------
MAX_ORDER_TOTAL=500.00
SWEEP_AFTER_SECONDS=60
DEMO_TOOLS=true
